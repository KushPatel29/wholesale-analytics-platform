# Demo configuration: runs the whole platform against the seeded synthetic
# dataset, with no SQL Server and no external services.
#
#   python -m seed.generate_synthetic_data
#   cp .env.demo .env          (or: make demo)
#   python manage.py init-auth-db && python manage.py seed-demo-users
#   python run.py
#
# Nothing here is secret. SECRET_KEY below is deliberately a placeholder that
# the config layer rejects in production.

ENV=development
FLASK_ENV=development
FORCE_HTTPS=false
DEV_INSECURE_COOKIES=true
SECRET_KEY=demo-only-not-a-real-secret

# Read the seeded parquet dataset instead of the source ERP.
DIRECT_SQL_ONLY=false
FACT_DATASET_PATH=cache/fact_dataset
PARQUET_PATH=cache/fact_dataset
CACHE_DIR=cache
CACHE_TTL_MINUTES=15
ORDER_STATUSES=packed
INITIAL_START_DATE=2024-01-01

# The demo dataset is static, so nothing needs refreshing in the background.
AUTO_REFRESH_ENABLED=false
ENABLE_INPROCESS_REFRESH=0
ALLOW_GUNICORN_INPROCESS_REFRESH=0
ENABLE_SSE=false

# Labor analytics reads a workforce-management API that the demo has no
# equivalent for, so the page is switched off rather than faked.
LABOR_ANALYTICS_ENABLED=0

# Show the newest version of every dashboard.
OVERVIEW_V2=1
OVERVIEW_V3=1
OVERVIEW_FORECAST_V2=1
OVERVIEW_MOVERS_FAST=1
PRODUCTS_V3=1
PRODUCTS_V4=1
PRODUCT_INTELLIGENCE_V2=1
PRODUCT_DRILLDOWN_V2=1
PRODUCT_FORECAST_V1=1
SUPPLIER_DRILLDOWN_V2=1
SALESREPS_V2=1
SALESREP_DRILLDOWN_V2=1
CUSTOMERS_KPIS_V2=1
CUSTOMERS_KPIS_V3=1
CUSTOMERS_RFM_V2=1
CUSTOMERS_CLV_V2=1

# The returns (RMA) module: credit-request intake, two-step approval and PDF
# export. Off by default in the shipped config; on here so the demo shows it.
RETURNS_ENABLED=1
RETURNS_FINAL_V1=1
RETURNS_ANALYTICS=1
RETURNS_REFUNDS_ENABLED=1

# Alert rules and digests. The mailer is not configured in the demo, so
# messages are composed and logged rather than sent.
NOTIFICATIONS_ENABLED=1

# Admin portal on, and access control actually ENFORCED rather than logged.
# This is the point of the demo logins: rep.dana sees only her own book, and
# viewer.nocost gets cost and margin back as null rather than merely hidden.
ADMIN_PORTAL_ENABLED=1
AUTHZ_DB_PERMISSIONS=1
AUTHZ_ENFORCEMENT=1
AUTHZ_ENFORCEMENT_MODE=enforce
ADMIN_USER_SELECT=1
INVITES_ENABLED=0

# The assistant needs a local model server; off by default so a clean clone
# boots without one.
AI_ENABLED=0
